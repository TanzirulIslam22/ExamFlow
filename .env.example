# ---- Server (Vercel env vars / server/.env) ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/examflow
JWT_SECRET=change_this_to_a_long_random_string
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Firebase Auth (for Google & Phone login). Get these from Firebase console → Project settings → General → Your apps → SDK setup.
FIREBASE_PROJECT_ID=examflow-project

# ---- Client (Vercel env vars / client/.env.local) ----
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=examflow-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=examflow-project
# VITE_FIREBASE_STORAGE_BUCKET=examflow-project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

